# Copie para .env e preencha.
PORT=3333
# 0.0.0.0 deixa o celular (na mesma Wi-Fi) acessar a API pelo IP do notebook
HOST=0.0.0.0

# MongoDB Atlas → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/convivio?retryWrites=true&w=majority

# Gere um valor aleatório longo, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-bem-longo
JWT_EXPIRES_IN=30d

CORS_ORIGIN=*

# Upload de fotos (perfil e posts) — cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
