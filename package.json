{
  "name": "convivio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @convivio/api",
    "dev:mobile": "npm run start -w @convivio/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "react": "19.2.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
